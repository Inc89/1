# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Пароль для входа в админку
ADMIN_PASSWORD=
# Случайная длинная строка для подписи cookie сессии
SESSION_SECRET=
# Ключ, с которым приложение «Контент завод» обращается к /api/subscription
APP_API_KEY=
